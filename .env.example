# Dayflow 服务端环境变量（本地开发可以整个文件都不要）。

# 站点共享的演示 Key：配置后，没填 Key 的访客会用它，
# 并按 IP 每天限次。留空表示「不开启演示额度」。
# 注意：这是你的额度，别放余额很大的 Key。
DEMO_KEY=

# 每个 IP 每天能用多少次演示额度。
DEMO_DAILY_LIMIT=20

# 全站每天总共能用多少次演示额度（防止换 IP 刷）。
# 0 = 不限制总次数，只按 IP 限；自己用可以设 0。
DEMO_GLOBAL_LIMIT=200

# 演示额度的自然日边界。默认按中国时区每天重置。
DEMO_TIME_ZONE=Asia/Shanghai

# 兼容旧变量名：如果只配了 DEEPSEEK_API_KEY，也会当作演示 Key 限流使用。
DEEPSEEK_API_KEY=

PORT=5173
